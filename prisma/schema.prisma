// Schema do Buscador NF CRM — coleta automática de notas fiscais (NF-e) na
// SEFAZ para múltiplos CNPJs, com integração ao ClickUp.
//
// Campos de "tipo fechado" (ambiente, status, papel de usuário) são strings
// validadas em código — veja src/lib/types.ts para os valores permitidos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Empresa {
  id           String   @id @default(cuid())
  cnpj         String   @unique // só dígitos, 14 caracteres
  razaoSocial  String
  ambiente     String   @default("PRODUCAO") // "PRODUCAO" | "HOMOLOGACAO"
  uf           String // sigla da UF do CNPJ (cUFAutor exigido pelo webservice)
  active       Boolean  @default(true)

  // Certificado digital A1 (.pfx/.p12), necessário para autenticar no
  // webservice da SEFAZ (TLS mútuo) e para assinar a Manifestação do
  // Destinatário. Armazenado cifrado em repouso — veja src/lib/crypto.ts.
  certPfxEnc      Bytes?
  certPasswordEnc String?
  certSubject     String? // extraído do certificado, só para exibição/conferência
  certValidUntil  DateTime?

  // Cursor de paginação incremental do webservice NFeDistribuicaoDFe
  // (NT 2014.002) — cada consulta retorna documentos com NSU > ultNSU.
  ultNsu String @default("000000000000000")
  maxNsu String @default("000000000000000")

  lastSyncAt    DateTime?
  lastSyncError String?

  // Cursor equivalente, mas do Ambiente de Dados Nacional (ADN) do Sistema
  // Nacional NFS-e — sequência de NSU independente da NF-e. Veja
  // src/lib/nfse/client.ts sobre a cobertura parcial (só municípios que já
  // aderiram ao padrão nacional).
  ultNsuNfse String @default("000000000000000")
  maxNsuNfse String @default("000000000000000")

  lastSyncNfseAt    DateTime?
  lastSyncNfseError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas    NotaFiscal[]
  notasServico NotaServico[]
  syncLogs SyncLog[]
}

model NotaFiscal {
  id            String   @id @default(cuid())
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String

  chaveAcesso   String   @unique // chave de acesso de 44 dígitos da NF-e
  nsu           String   // NSU do documento na Distribuição DFe (para depuração/auditoria)
  numero        String
  serie         String
  emitenteCnpj  String
  emitenteNome  String
  valorTotal    Decimal  @db.Decimal(14, 2)
  dataEmissao   DateTime

  // "RESUMO": só o resumo (resNFe) foi recebido — ainda não manifestado /
  // XML completo não liberado pela SEFAZ.
  // "COMPLETA": XML completo (procNFe) obtido após manifestação de ciência.
  status String @default("RESUMO")

  xmlResumo    String? // XML do resNFe, sempre disponível
  xmlCompleto  String? // XML do procNFe, só após manifestação + nova consulta

  manifestadaEm DateTime?

  clickupTaskId  String?
  clickupTaskUrl String?
  clickupSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([status])
}

// Nota Fiscal de Serviço Eletrônica (NFS-e), coletada via Sistema Nacional
// NFS-e / Ambiente de Dados Nacional (ADN) — cobertura limitada aos
// municípios que já aderiram ao padrão nacional (veja README).
model NotaServico {
  id        String  @id @default(cuid())
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String

  chaveAcesso String @unique // chave de acesso da NFS-e (padrão nacional)
  nsu         String // NSU do documento no ADN (para depuração/auditoria)
  numero      String

  prestadorCnpj String
  prestadorNome String
  tomadorCnpj   String

  valorServico Decimal @db.Decimal(14, 2)
  discriminacao String?
  dataEmissao  DateTime

  xmlCompleto String // XML da NFS-e (o ADN já entrega o documento completo, sem etapa de manifestação)

  clickupTaskId    String?
  clickupTaskUrl   String?
  clickupSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
}

model SyncLog {
  id         String   @id @default(cuid())
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId  String

  // "NFE" (SEFAZ, Distribuição DFe) | "NFSE" (ADN, Sistema Nacional NFS-e)
  tipoDocumento String @default("NFE")

  startedAt  DateTime @default(now())
  finishedAt DateTime?
  status     String   @default("EM_ANDAMENTO") // "EM_ANDAMENTO" | "SUCESSO" | "ERRO"
  notasNovas Int      @default(0)
  mensagem   String?

  @@index([empresaId])
}
